---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Berean Bible College">
  <div class="hero">
    <div class="hero-content">
      <img src="/images/new_Temple_sharpened.jpg" alt="Berean Bible College" class="logo">
      <h1>Berean Bible College</h1>
      <p class="tagline">Training servants for the Great Commission</p>

      <div class="links">
        <a href="/store/" class="enter-button">Enter Bookstore</a>
        <a href="/bible/" class="link">Bible Resources</a>
        <a href="/eden/" class="link">Missionary Training</a>
        <a href="/news/" class="link">News</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .hero {
    min-height: 100vh;
    background: linear-gradient(135deg, #002147 0%, #001a33 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px;
  }

  .hero-content {
    max-width: 600px;
  }

  .logo {
    width: 120px;
    height: auto;
    margin-bottom: 20px;
    border-radius: 8px;
  }

  h1 {
    color: white;
    font-size: 2.5rem;
    margin: 0 0 10px 0;
  }

  .tagline {
    color: rgba(255, 255, 255, 0.8);
    font-size: 1.2rem;
    margin: 0 0 40px 0;
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: 15px;
    align-items: center;
  }

  .enter-button {
    display: inline-block;
    background: #228B22;
    color: white;
    padding: 15px 40px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    font-size: 1.1rem;
    transition: background 0.3s;
  }

  .enter-button:hover {
    background: #32CD32;
    color: black;
  }

  .link {
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    font-size: 1rem;
  }

  .link:hover {
    text-decoration: underline;
  }

  @media (max-width: 600px) {
    h1 {
      font-size: 1.8rem;
    }

    .tagline {
      font-size: 1rem;
    }
  }
</style>
