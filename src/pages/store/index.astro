---
// Store landing page - matches original store/index.html exactly
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Berean Bible College — Store</title>
  <style>
    html,body{margin:0;padding:0;height:100%;font-family:'Helvetica Neue',Helvetica,Arial,serif;background:black;color:#fff}
    .hero{
      width:100%;height:100vh;position:relative;
      background-image:url("https://cdn.shopify.com/s/files/1/0754/3570/4578/files/Jesus_figure_holding_boys_hand_in_fog.png?v=1746574956");
      background-size:cover;background-position:center top;background-repeat:no-repeat;
      display:flex;flex-direction:column;justify-content:flex-start;align-items:flex-start;padding:3% 5%;box-sizing:border-box;overflow:hidden;
    }
    .hero h1{font-size:2.5rem;margin:0 0 1rem 0}
    .callout,.subtitle{font-size:1rem;line-height:1.2;margin:0.2rem 0;max-width:300px}
    .subtitle{font-style:italic}
    .links{display:flex;flex-direction:column;gap:.3rem;margin-top:1rem}
    .links a{font-size:1rem;color:white;text-decoration:none}
    .links a:hover{color:#D4AF37}
    .enter-button {
      position:absolute;
      bottom:40px;
      left:40px;
      background-color:#228B22;
      color:white;
      padding:12px 24px;
      font-size:1.1rem;
      text-decoration:none;
      border-radius:6px;
      transition:background-color 0.3s ease;
    }
    .enter-button:hover {
      background-color:#32CD32;
      color:black;
    }
    .logo-stack{position:absolute;bottom:20px;left:20px;display:flex;flex-direction:column;gap:8px;align-items:flex-start;z-index:10}
    .logo-row{display:flex;gap:15px;align-items:center}
    .logo-row img{display:block;height:50px;width:auto}
    .ucsvm-row{display:flex;gap:12px;align-items:center}
    .ucsvm-row img{display:block;height:40px}
    .ucsvm-text{color:white;font-size:1rem;white-space:nowrap}
    @media (max-width:768px){
      .hero h1{font-size:2rem}
      .callout,.subtitle,.links a{font-size:.9rem}
      .logo-row img{height:40px}
      .ucsvm-row img{height:30px}
      .ucsvm-text{font-size:.9rem}
      .enter-button {bottom:20px;left:20px;font-size:.95rem;padding:10px 18px;}
    }
  </style>
</head>
<body>
  <div class="hero">
    <h1>Inner Sanctum Bookstore</h1>
    <div class="callout">
      <p>"Buy the truth, and sell it not."</p> <p>— Proverbs 23:23</p>
    </div>
    <div class="subtitle">Jesus came. He's coming again…to stay!</div>

    <!-- Green ENTER BOOKSTORE button - links to narthex -->
    <a href="./narthex.html" class="enter-button">ENTER BOOKSTORE</a>
  </div>
</body>
</html>
